# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Port for local testing (Render injects PORT automatically in production)
PORT=5000

# Frontend URL deployed on Netlify (e.g., https://your-app-name.netlify.app)
# Leave blank or set to * during testing
FRONTEND_URL=https://your-poll-app.netlify.app

# Master Admin Key for protected operations (like deleting polls)
# Default is 'admin123' if left unset
ADMIN_KEY=admin123
